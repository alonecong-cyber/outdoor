# OutdoorDeal 后端配置模板 —— 复制为 backend/.env（已被 .gitignore 忽略）
# 代码里只读环境变量，绝不硬编码密钥。

# 数据库（SQLite 起步；默认 backend/var/outdoordeal.db）
DB_PATH=

# 调度器：定期更新数据与站内提醒；外部发送单独启用
SCHEDULER_ENABLED=false
NOTIFICATIONS_ENABLED=false
COLLECT_INTERVAL_MINUTES=60
INGEST_DEALS_INTERVAL_MINUTES=60
INGEST_DEALS_MAX_DETAILS=8
OFFER_FRESHNESS_HOURS=24
DEAL_RECHECK_HOURS=6
# 有联盟凭据时默认采集这些关键词；JSON数组，支持自行扩展
COLLECTION_KEYWORDS=["始祖鸟","北面","Patagonia"]
# 可覆盖默认任务，例如 [{"source":"jd_union","keywords":"始祖鸟"}]
COLLECTION_SPECS=[]

# ---- 京东联盟（宙斯开放平台 jos.jd.com）----
JD_UNION_APP_KEY=
JD_UNION_SECRET_KEY=

# ---- 淘宝联盟（淘宝客）----
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_PID=

# ---- AvantLink（REI / Backcountry 等海外渠道）----
AVANTLINK_AFFILIATE_ID=
AVANTLINK_WEBSITE_ID=
AVANTLINK_API_KEY=

# ---- 通知渠道 ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
WECOM_WEBHOOK=

# ---- 汇率（缺省值，正式运行走每日刷新任务）----
USD_CNY_RATE=7.1
